{
  "name": "archipilot-bureau",
  "productName": "ARCHIPILOT",
  "version": "0.1.0",
  "description": "ARCHIPILOT pour Windows : affiche la version en ligne, avec raccourcis clavier globaux et saisie rapide.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "fr.mf-archi.archipilot",
    "productName": "ARCHIPILOT",
    "files": ["main.js", "preload.js", "reglages.html", "reglages.js", "package.json", "AP.ico"],
    "win": { "icon": "AP.ico", "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
