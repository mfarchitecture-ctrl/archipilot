// Configuration Cloudflare d'ARCHIPILOT hébergé (même principe que KELZONE).
// Seul le dossier public/ est publié ; worker.js répond aux adresses /api/*.
{
  "name": "archipilot",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "archipilot",
      // Base créée le 2026-10-01 dans Cloudflare (D1 SQL database).
      "database_id": "72c5f5e8-593e-4d17-a6a5-26a26a12d529"
    }
  ]
  // Secret à définir dans Cloudflare (Settings > Variables and Secrets) : CODE_INVITATION.
}
